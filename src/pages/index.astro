---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementBar from '../components/layout/AnnouncementBar.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Deliveries from '../components/sections/Deliveries.astro';
import Process from '../components/sections/Process.astro';
import EngagementModels from '../components/sections/EngagementModels.astro';
import Differentials from '../components/sections/Differentials.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout>
  <AnnouncementBar />
  <Header />
  <main id="conteudo">
    <Hero />
    <Services />
    <Deliveries />
    <Process />
    <EngagementModels />
    <Differentials />
    <Faq />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
