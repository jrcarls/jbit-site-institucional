---
import type { HTMLAttributes } from 'astro/types';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  variant?: 'primary' | 'default';
  href?: string;
};

const { variant = 'default', href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class:list={['px-frame', 'btn', { 'btn--primary': variant === 'primary' }, className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    background: var(--px-surface);
    color: var(--px-text);
    font: 600 17px/1.2 var(--px-font-pixel);
    text-decoration: none;
    cursor: pointer;
    transition: transform 120ms steps(2);
  }
  .btn--primary {
    --o: var(--px-lime-dark);
    --s: var(--px-lime-darker);
    --hl: rgba(255, 255, 255, 0.6);
    --sh: rgba(60, 90, 10, 0.35);
    background: var(--px-lime);
    color: var(--px-ink);
  }
  .btn:hover {
    transform: translateY(calc(-1 * var(--px-unit)));
  }
  .btn:active {
    transform: translateY(var(--px-unit));
    --s: transparent;
  }
  .btn:not(.btn--primary):hover {
    --o: var(--px-brand);
  }
  @media (max-width: 560px) {
    .btn {
      font-size: 15px;
      padding: 10px 12px;
    }
  }
</style>
