---
import type { HTMLTag } from 'astro/types';

type Props = {
  /** Texto da barra de título (estilo "janela"). */
  title?: string;
  titleId?: string;
  as?: HTMLTag;
  class?: string;
};

const { title, titleId, as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['px-frame', 'card', className]}>
  {title && <div class="card__title" id={titleId}>{title}</div>}
  <div class="card__body"><slot /></div>
</Tag>

<style>
  .card {
    background: linear-gradient(180deg, var(--px-card-top), var(--px-surface) 120px);
  }
  .card__title {
    margin: 0;
    padding: 10px 18px;
    background: var(--px-soft);
    border-bottom: var(--px-unit) solid var(--px-border);
    box-shadow: inset 0 3px 0 var(--px-pink);
    font: 600 16px/1.3 var(--px-font-pixel);
  }
  .card__body {
    padding: 20px;
  }
</style>
