---
import type { TerminalLine } from '../../types';
import { accentVar } from '../../utils/colors';

/**
 * Janela pixelada estilo terminal. Com `animate`, o comando é "digitado" e as
 * linhas aparecem uma a uma ao carregar (uma vez só; respeita reduzir movimento).
 */
type Props = { file: string; lines: TerminalLine[]; animate?: boolean; class?: string };
const { file, lines, animate = false, class: className } = Astro.props;

const prefix: Record<TerminalLine['kind'], string> = { command: '$', ok: '✓', info: '→' };
---

<figure class:list={['px-frame', 'window', className]} data-terminal={animate ? '' : undefined}>
  <figcaption class="window__bar">
    <span class="window__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {file}
  </figcaption>
  <pre class="window__body"><code>{
    lines.map((l) => (
      <span class:list={['line', `line--${l.kind}`]} style={l.color && `--c:${accentVar(l.color)}`}><span class="line__prefix" aria-hidden="true">{prefix[l.kind]}</span> <span class="line__text">{l.text}</span>
</span>
    ))
  }</code></pre>
</figure>
{
  animate && (
    <>
      {/* Esconde as linhas antes da primeira pintura (evita "piscar"). Sem JS, tudo aparece normal. */}
      <script is:inline>
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.querySelectorAll('[data-terminal]').forEach((el) => el.classList.add('is-pending'));
      </script>
      <script>
        import { playTerminals } from '../../scripts/terminal';
        playTerminals();
      </script>
    </>
  )
}

<style>
  .window {
    --o: #755196;
    --s: #100d17;
    /* A janela é sempre escura: fixa as cores de destaque da paleta escura. */
    --px-accent: #c8ff32;
    --px-pink: #ff5cad;
    --px-orange: #ff814a;
    --px-sky: #6fd3ff;
    background: var(--px-ink);
    color: #f7f8f4;
  }
  .window__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: #332346;
    border-bottom: var(--px-unit) solid #53436b;
    box-shadow: inset 0 3px 0 #ff814a;
    font: 600 16px/1.3 var(--px-font-pixel);
  }
  .window__dots {
    display: inline-flex;
    gap: 6px;
  }
  .window__dots i {
    width: 10px;
    height: 10px;
    background: #ff814a;
  }
  .window__dots i:nth-child(2) {
    background: #6fd3ff;
  }
  .window__dots i:nth-child(3) {
    background: #c8ff32;
  }
  .window__body {
    margin: 0;
    padding: 20px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font: 14px/1.9 var(--px-font-mono);
  }
  @media (max-width: 560px) {
    .window__body {
      padding: 16px;
      font-size: 13px;
    }
  }
  .window__body code {
    font: inherit;
    background: none;
    padding: 0;
    color: inherit;
  }
  /* Estados da animação */
  .window.is-pending .line {
    visibility: hidden;
  }
  .window .line.is-shown {
    visibility: visible;
  }
  .window :global(.caret) {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: #c8ff32;
  }
  .line__prefix {
    color: var(--c, #c8ff32);
    font-weight: bold;
  }
  .line--command {
    color: #f7f8f4;
  }
  .line--ok {
    color: #bdb2ce;
  }
  .line--info {
    color: #6fd3ff;
  }
</style>
