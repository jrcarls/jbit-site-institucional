---
import { px, type Pixel } from '../../utils/pixelArt';

/**
 * Cena em pixel art do "estúdio" da empresa, montada com pequenas funções
 * (janela, mesa, monitor, pessoa, rack). Ajuste/reordene à vontade.
 */
type Props = { label: string };
const { label } = Astro.props;

const W = 192;
const H = 96;
const C = {
  wall: '#2a1f40', trim: '#3a2b55', floorA: '#332346', floorB: '#2a1d3d',
  frame: '#53436b', ink: '#100c18', screen: '#211735', wood: '#8a5a3c', woodDark: '#5e3a26',
  lime: '#C8FF32', pink: '#FF5CAD', orange: '#FF814A', sky: '#6FD3FF', night: '#1d3a5c',
  skin: '#f2c29b', hair: '#3b2a1e', leaf: '#5e7f1e', leafLight: '#8fbf2a', pot: '#a84a1f', white: '#F7F8F4',
};

const room = (): Pixel[] => {
  const out = [px(0, 0, W, 64, C.wall), px(0, 60, W, 4, C.trim)];
  for (let y = 64; y < H; y += 8)
    for (let x = 0; x < W; x += 8) out.push(px(x, y, 8, 8, (x + y) % 16 === 0 ? C.floorA : C.floorB));
  return out;
};

const windowAt = (x: number, y: number): Pixel[] => [
  px(x, y, 40, 28, C.frame),
  px(x + 2, y + 2, 36, 24, C.night),
  px(x + 19, y + 2, 2, 24, C.frame),
  px(x + 2, y + 13, 36, 2, C.frame),
  px(x + 6, y + 5, 1, 1, C.white, 'twinkle'),
  px(x + 14, y + 9, 1, 1, C.white),
  px(x + 27, y + 6, 1, 1, C.white, 'twinkle'),
  px(x + 31, y + 4, 4, 4, '#fff3b0'),
  px(x + 9, y + 19, 1, 1, C.white),
  px(x + 30, y + 21, 1, 1, C.white, 'twinkle'),
];

const codeLines = (x: number, y: number, colors: string[]): Pixel[] =>
  colors.map((c, i) => px(x + (i % 3 === 1 ? 4 : 0), y + i * 3, 6 + ((i * 7) % 12), 2, c));

const desk = (x: number, code: string[]): Pixel[] => [
  // monitor
  px(x + 10, 34, 30, 22, C.ink),
  px(x + 12, 36, 26, 18, C.screen),
  ...codeLines(x + 14, 38, code),
  px(x + 30, 50, 2, 2, C.lime, 'cursor'),
  px(x + 23, 56, 4, 2, C.ink),
  // tampo e pernas
  px(x, 58, 50, 4, C.wood),
  px(x, 62, 50, 1, C.woodDark),
  px(x + 2, 63, 3, 14, C.woodDark),
  px(x + 45, 63, 3, 14, C.woodDark),
  // teclado e caneca
  px(x + 16, 56, 16, 2, C.frame),
  px(x + 40, 53, 4, 5, C.orange),
  px(x + 44, 54, 1, 2, C.orange),
];

const person = (x: number, y: number, shirt: string, hair = C.hair): Pixel[] => [
  px(x + 1, y, 6, 2, hair),
  px(x + 1, y + 2, 6, 5, C.skin),
  px(x + 1, y + 2, 1, 3, hair),
  px(x + 5, y + 4, 1, 1, C.ink),
  px(x, y + 7, 8, 10, shirt),
  px(x + 8, y + 9, 3, 2, C.skin),
  px(x + 1, y + 17, 3, 8, C.screen),
  px(x + 4, y + 17, 3, 8, C.screen),
];

const chair = (x: number): Pixel[] => [px(x, 52, 3, 18, C.ink), px(x, 68, 12, 3, C.ink), px(x + 5, 71, 2, 6, C.ink)];

const rack = (x: number, y: number): Pixel[] => {
  const out = [px(x, y, 22, 40, C.ink), px(x + 2, y + 2, 18, 36, C.screen)];
  for (let i = 0; i < 5; i++) {
    const ry = y + 4 + i * 7;
    out.push(px(x + 3, ry, 16, 5, C.frame));
    out.push(px(x + 5, ry + 2, 2, 1, i % 2 ? C.lime : C.sky, i % 2 ? 'blink' : 'blink-alt'));
    out.push(px(x + 9, ry + 2, 8, 1, C.ink));
  }
  return out;
};

const plant = (x: number, y: number): Pixel[] => [
  px(x + 4, y, 4, 6, C.leafLight),
  px(x, y + 4, 4, 6, C.leaf),
  px(x + 8, y + 3, 4, 7, C.leaf),
  px(x + 3, y + 6, 6, 5, C.leafLight),
  px(x + 2, y + 11, 8, 8, C.pot),
  px(x + 2, y + 11, 8, 2, C.orange),
];

const board = (x: number, y: number): Pixel[] => [
  px(x, y, 34, 22, C.frame),
  px(x + 2, y + 2, 30, 18, C.white),
  px(x + 5, y + 5, 10, 2, C.pink),
  px(x + 5, y + 9, 16, 2, C.sky),
  px(x + 5, y + 13, 8, 2, C.orange),
  px(x + 22, y + 12, 6, 6, C.lime),
];

const scene: Pixel[] = [
  ...room(),
  ...windowAt(8, 10),
  ...board(100, 12),
  ...plant(56, 45),
  ...desk(22, [C.pink, C.lime, C.sky, C.orange, C.lime]),
  ...chair(14),
  ...person(4, 46, C.pink),
  ...desk(92, [C.sky, C.orange, C.lime, C.pink, C.sky]),
  ...person(146, 41, C.sky, '#c2417f'),
  ...rack(162, 24),
];
---

<svg
  class="studio"
  viewBox={`0 0 ${W} ${H}`}
  shape-rendering="crispEdges"
  role="img"
  aria-label={label}
>
  {scene.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} class={p.cls} />)}
</svg>

<style>
  .studio {
    display: block;
    width: 100%;
    height: auto;
  }
  .blink {
    animation: blink 1.2s steps(1) infinite;
  }
  .blink-alt {
    animation: blink 0.9s steps(1) infinite reverse;
  }
  .cursor {
    animation: blink 1s steps(1) infinite;
  }
  .twinkle {
    animation: blink 2.4s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
