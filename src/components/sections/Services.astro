---
import { services } from '../../data/services';
import { accentAt, accentVar } from '../../utils/colors';
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import SectionIntro from '../ui/SectionIntro.astro';
---

<section class="section" id="servicos">
  <div class="wrap">
    <Heading>O que a gente <em class="sky">constrói</em></Heading>
    <SectionIntro>Do primeiro site ao sistema que roda a operação inteira da empresa.</SectionIntro>
    <ul class="grid-4">
      {
        services.map((s, i) => (
          <li style={`--c:${accentVar(accentAt(i))}`}>
            <Card title={s.tag} class="service">
              <h3>{s.title}</h3>
              <p>{s.description}</p>
              <ul class="px-bullets">
                {s.items.map((item) => <li>{item}</li>)}
              </ul>
            </Card>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  li > :global(.service) {
    height: calc(100% - 2 * var(--px-unit));
  }
  h3 {
    margin: 0 0 8px;
    font: 600 18px/1.3 var(--px-font-pixel);
    color: var(--c);
  }
  p {
    margin: 0 0 12px;
    color: var(--px-muted);
    font-size: 13px;
  }
  .px-bullets {
    font-size: 13px;
  }
</style>
