---
import { site } from '../../config/site';
import Button from '../ui/Button.astro';
import Heading from '../ui/Heading.astro';
import PixelMark from '../illustrations/PixelMark.astro';
---

<section class="section" id="contato">
  <div class="wrap final">
    <PixelMark size={132} class="final__mark" />
    <div>
      <Heading>Bora tirar sua ideia do <em>papel</em>?</Heading>
      <p>Conte o que você precisa. Respondemos em até 24 horas úteis com os próximos passos.</p>
      <div class="ctas">
        <Button variant="primary" href={`mailto:${site.email}?subject=Novo%20projeto`}>
          Enviar e-mail
        </Button>
        {
          site.whatsapp && (
            <Button href={site.whatsapp} target="_blank" rel="noopener noreferrer">
              Chamar no WhatsApp
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .final {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  .final :global(.final__mark) {
    filter: drop-shadow(4px 4px 0 var(--px-shadow));
  }
  p {
    color: var(--px-muted);
    margin: 10px 0 0;
    font-size: 15px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  @media (max-width: 560px) {
    .final {
      grid-template-columns: minmax(0, 1fr);
    }
    .final :global(.final__mark) {
      width: 88px;
      height: 88px;
    }
  }
</style>
