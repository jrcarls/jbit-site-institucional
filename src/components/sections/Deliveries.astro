---
import { deliveries } from '../../data/deliveries';
import { reasons } from '../../data/highlights';
import { accentVar } from '../../utils/colors';
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import SectionIntro from '../ui/SectionIntro.astro';
---

<section class="section" id="entregas">
  <div class="wrap split">
    <div>
      <Heading>Uma semana no <em>estúdio</em></Heading>
      <SectionIntro>
        É assim que um projeto avança com a gente: pequenas entregas, todo dia, visíveis para o
        cliente. Registro ilustrativo.
      </SectionIntro>
      <Card title="Entregas recentes" titleId="log-title">
        <div class="log" role="region" aria-labelledby="log-title" tabindex="0">
          <table>
            <thead>
              <tr>
                <th scope="col">Data</th>
                <th scope="col">Time</th>
                <th scope="col">Projeto</th>
                <th scope="col">Entrega</th>
              </tr>
            </thead>
            <tbody>
              {
                deliveries.map((d) => (
                  <tr>
                    <td class="date">{d.date}</td>
                    <td class="team">{d.team}</td>
                    <td>
                      <span class="proj" style={`--c:${accentVar(d.color)}`}>
                        <b>{d.initial}</b>
                        {d.project}
                      </span>
                    </td>
                    <td>{d.summary}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </Card>
    </div>

    <div>
      <Heading level={3}>Por que a JBIT</Heading>
      <ul class="feats">
        {
          reasons.map((r) => (
            <li style={`--c:${accentVar(r.color)}`}>
              <div>
                <strong>{r.title}</strong>
                <span>{r.description}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 40px;
    align-items: start;
  }
  .log {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font: 13px/1.5 var(--px-font-body);
    min-width: 480px;
  }
  th {
    font: 600 14px var(--px-font-pixel);
    text-align: left;
    color: var(--px-muted);
    padding: 0 10px 8px;
    border-bottom: var(--px-unit) solid var(--px-border);
  }
  td {
    padding: 9px 10px;
    border-bottom: 1px dashed var(--px-border);
    vertical-align: top;
  }
  .date {
    font-family: var(--px-font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--px-muted);
    white-space: nowrap;
  }
  .team {
    font-weight: bold;
    white-space: nowrap;
  }
  .proj {
    display: inline-block;
    font: bold 11px/1.4 var(--px-font-body);
    padding: 1px 6px;
    background: var(--px-soft);
    white-space: nowrap;
  }
  .proj b {
    display: inline-block;
    width: 14px;
    text-align: center;
    color: var(--px-ink);
    background: var(--c);
    margin-right: 4px;
  }
  .feats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .feats li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .feats li::before {
    content: '';
    flex: 0 0 10px;
    height: 10px;
    margin-top: 7px;
    background: var(--c);
    box-shadow: 3px 3px 0 var(--px-shadow);
  }
  .feats strong {
    font: 600 17px/1.3 var(--px-font-pixel);
    display: block;
  }
  .feats span {
    color: var(--px-muted);
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
