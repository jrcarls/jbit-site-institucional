---
import { engagementModels, includedInAll } from '../../data/engagement';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Heading from '../ui/Heading.astro';
import SectionIntro from '../ui/SectionIntro.astro';

// A largura de cada card segue o "tamanho" do modelo (como as salas do original).
const columns = engagementModels.map((m) => `minmax(0, ${m.size}fr)`).join(' ');
---

<section class="section" id="modelos">
  <div class="wrap">
    <Heading>Escolha como <em>trabalhar</em> com a gente</Heading>
    <SectionIntro>
      Do projeto pontual a um time inteiro cuidando da sua tecnologia. A largura de cada cartão
      acompanha o tamanho do compromisso.
    </SectionIntro>

    <div class="models" style={`--cols:${columns}`}>
      {
        engagementModels.map((m) => (
          <article class:list={['px-frame', 'model', { 'is-featured': m.featured }]}>
            {m.featured && (
              <Badge variant="hot" class="featured">
                {m.featured}
              </Badge>
            )}
            <p class="model__name">{m.name}</p>
            <p class="model__sub">{m.subtitle}</p>
            <p class="model__for">{m.idealFor}</p>
            <p class="model__details">{m.details}</p>
            <ul class="px-bullets model__items">
              {m.items.map((item) => <li>{item}</li>)}
            </ul>
            <Button href={m.cta.href} variant={m.featured ? 'primary' : 'default'} class="model__cta">
              {m.cta.label}
            </Button>
          </article>
        ))
      }
    </div>

    <div class="includes">
      <h3>Todos os modelos incluem</h3>
      <ul>{includedInAll.map((item) => <li>{item}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .models {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 16px;
    align-items: stretch;
  }
  .model {
    --hl: transparent;
    --sh: transparent;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    background: linear-gradient(180deg, var(--px-card-top), var(--px-surface) 90px);
  }
  .model.is-featured {
    --o: #ff814a;
  }
  .model :global(.featured) {
    position: absolute;
    top: -14px;
    right: 10px;
  }
  .model p {
    margin: 0;
  }
  .model__name {
    font: 600 22px/1.2 var(--px-font-pixel);
    color: var(--px-accent);
  }
  .model__sub {
    font-weight: bold;
  }
  .model__for {
    font: bold 13px/1.4 var(--px-font-body);
    color: var(--px-pink);
  }
  .model__details {
    font-size: 12px;
    color: var(--px-muted);
  }
  .model__items {
    margin: 6px 0 12px;
    font-size: 13px;
  }
  .model :global(.model__cta) {
    margin-top: auto;
    align-self: flex-start;
  }
  .includes {
    display: grid;
    gap: 10px;
    margin-top: 26px;
    padding: 16px 18px;
    border: 2px dashed var(--px-border);
  }
  .includes h3 {
    margin: 0;
    font: 600 17px/1.2 var(--px-font-pixel);
    color: var(--px-accent);
  }
  .includes ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 13px;
  }
  .includes li::before {
    content: '✓ ';
    color: var(--px-accent);
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .models {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
